{
  "manifest_version": 3,
  "name": "AudioMint",
  "version": "0.1.0",
  "description": "Extract audio from YouTube videos and download it as an MP3 file.",
  "action": {
    "default_title": "AudioMint",
    "default_popup": "index.html"
  },
  "permissions": [
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}